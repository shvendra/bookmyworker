{
  "expo": {
    "name": "BookMyWorker",
    "slug": "bookmyworker-agent",
    "version": "12.3.53",
    "description": "BookMyWorker \u2013 India's trusted platform for workers, agents & employers. Find skilled workers instantly, register your team, and earn commissions.",
    "orientation": "portrait",
    "scheme": "bookmyworker-agent",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ECFEFF"
    },
    "plugins": [
      "expo-localization",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow BookMyWorker users to upload profile and KYC photos only.",
          "cameraPermission": "Allow BookMyWorker users to capture profile and KYC photos."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#1137A4",
          "defaultChannel": "default",
          "sounds": []
        }
      ],
      "expo-font"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bookmyworkers.agent",
      "buildNumber": "1241",
      "infoPlist": {
        "NSCameraUsageDescription": "Used for capturing profile and KYC documents.",
        "NSPhotoLibraryUsageDescription": "Used only for selecting profile and KYC photos.",
        "NSLocationWhenInUseUsageDescription": "Used to show nearby jobs and attendance location."
      }
    },
    "android": {
      "package": "com.app.myworker",
      "googleServicesFile": "./google-services.json",
      "versionCode": 1331,
      "versionName": "12.3.52",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#034FC9"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.WAKE_LOCK",
        "android.permission.RECORD_AUDIO"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "apiBaseUrl": "https://www.bookmyworkers.com",
      "eas": {
        "projectId": "ed89ef54-3e18-46f1-af1a-fe038fd6fc84"
      }
    },
    "owner": "singh2495shivendra",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/ed89ef54-3e18-46f1-af1a-fe038fd6fc84"
    }
  }
}
