{
  "expo": {
    "name": "BookMyWorkers",
    "slug": "bookmyworkers-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "bookmyworkers",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,

    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },

    "plugins": [
      "expo-localization",
      "expo-secure-store",

      [
        "expo-image-picker",
        {
          "photosPermission": "Allow users to upload profile and KYC photos only.",
          "cameraPermission": "Allow users to capture profile and KYC photos."
        }
      ],

      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#4F46E5",
          "defaultChannel": "default",
          "sounds": []
        }
      ]
    ],

    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bookmyworkers.mobile",

      "infoPlist": {
        "NSCameraUsageDescription": "Used for capturing profile and KYC documents.",
        "NSPhotoLibraryUsageDescription": "Used only for selecting profile and KYC photos.",
        "NSLocationWhenInUseUsageDescription": "Used to show nearby workers and attendance location."
      }
    },

    "android": {
      "package": "com.bookmyworkers.mobile",

      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#4F46E5"
      },

      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,

      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.WAKE_LOCK"
      ],

      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ]
    },

    "web": {
      "favicon": "./assets/favicon.png"
    },

    "extra": {
      "apiBaseUrl": "https://www.bookmyworkers.com",

      "eas": {
        "projectId": "bookmyworkers-mobile"
      }
    }
  }
}