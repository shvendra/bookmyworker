{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "react-native-webview": ["./node_modules/react-native-webview"],
      "react": ["./node_modules/@types/react"],
      "react-dom": ["./node_modules/@types/react-dom"],
      "*": ["./node_modules/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.d.ts",
    "../packages/shared-mobile/src/**/*.ts",
    "../packages/shared-mobile/src/**/*.tsx"
  ],
  "exclude": [
    "src/__tests__",
    "../packages/shared-mobile/src/**/__tests__/**"
  ]
}
