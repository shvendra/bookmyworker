{
  "cli": {
    "version": ">= 16.19.3",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://bookmyworkers.com",
        "EXPO_PUBLIC_SOCKET_BASE_URL": "https://bookmyworkers.com"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://bookmyworkers.com",
        "EXPO_PUBLIC_SOCKET_BASE_URL": "https://bookmyworkers.com"
      }
    },
    "production": {
      "channel": "production",
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://bookmyworkers.com",
        "EXPO_PUBLIC_SOCKET_BASE_URL": "https://bookmyworkers.com"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
