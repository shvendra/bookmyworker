{
  "expo": {
    "name": "BookMyWorker Recruiter",
    "slug": "bookmyworker-employer",
    "version": "1.0.43",
    "orientation": "portrait",
    "scheme": "bookmyworker-employer",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F3EFFE"
    },
    "plugins": [
      "expo-localization",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow users to upload profile and KYC photos only.",
          "cameraPermission": "Allow users to capture profile and KYC photos."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#1137A4",
          "defaultChannel": "default",
          "sounds": []
        }
      ],
      "expo-font"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bookmyworkers.employer",
      "infoPlist": {
        "NSCameraUsageDescription": "Used for capturing profile and KYC documents.",
        "NSPhotoLibraryUsageDescription": "Used only for selecting profile and KYC photos."
      }
    },
    "android": {
      "package": "com.bookmyworkers.employer",
      "googleServicesFile": "./google-services.json",
      "versionCode": 55,
      "versionName": "1.0.43",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#034FC9"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.WAKE_LOCK",
        "android.permission.RECORD_AUDIO"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "apiBaseUrl": "https://www.bookmyworkers.com",
      "eas": {
        "projectId": "26a471b1-82cf-4e21-ba26-6f8f6a82f6e4"
      }
    },
    "owner": "singh2495shivendra",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/26a471b1-82cf-4e21-ba26-6f8f6a82f6e4"
    }
  }
}
